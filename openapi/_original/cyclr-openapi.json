{"openapi":"3.1.0","info":{"title":"Cyclr Agent Content API","version":"0.5.0","description":"Public, read-only, agent-friendly API for discovering Cyclr website content, retrieving page metadata, searching connectors and finding relevant Cyclr resources. This API does not expose WordPress administration, Formidable Forms entries, HubSpot data, customer data, or write actions."},"servers":[{"url":"https:\/\/cyclr.com\/wp-json\/cyclr-agent\/v1"}],"paths":{"\/status":{"get":{"summary":"Get API status","operationId":"getCyclrAgentApiStatus","responses":{"200":{"description":"Status response","content":{"application\/json":{"schema":{"type":"object"}}}}}}},"\/search":{"get":{"summary":"Search public Cyclr website content","operationId":"searchCyclrSite","parameters":[{"name":"query","in":"query","required":true,"schema":{"type":"string"},"description":"Search query"},{"name":"type","in":"query","required":false,"schema":{"type":"string"},"description":"Optional content type filter such as any, product, report, resource, case-study, connector, integration, article or page"}],"responses":{"200":{"description":"Search results","content":{"application\/json":{"schema":{"type":"object"}}}}}}},"\/page":{"get":{"summary":"Get structured metadata for a public Cyclr page","operationId":"getCyclrPageContext","parameters":[{"name":"url","in":"query","required":false,"schema":{"type":"string"},"description":"Same-site Cyclr URL or path"},{"name":"path","in":"query","required":false,"schema":{"type":"string"},"description":"Same-site Cyclr path"}],"responses":{"200":{"description":"Page context","content":{"application\/json":{"schema":{"type":"object"}}}}}}},"\/content-index":{"get":{"summary":"Get curated public Cyclr content index","operationId":"getCyclrContentIndex","parameters":[{"name":"section","in":"query","required":false,"schema":{"type":"string"},"description":"Optional section filter such as products, reports, case_studies or agent_resources"},{"name":"limit","in":"query","required":false,"schema":{"type":"integer"},"description":"Maximum items per section"}],"responses":{"200":{"description":"Content index","content":{"application\/json":{"schema":{"type":"object"}}}}}}},"\/connectors":{"get":{"summary":"Search Cyclr connector and integration pages","operationId":"searchCyclrConnectors","parameters":[{"name":"query","in":"query","required":true,"schema":{"type":"string"},"description":"Connector, application, API or category query"},{"name":"category","in":"query","required":false,"schema":{"type":"string"},"description":"Optional connector category"}],"responses":{"200":{"description":"Connector search results","content":{"application\/json":{"schema":{"type":"object"}}}}}}},"\/recommend":{"get":{"summary":"Recommend relevant Cyclr pages for a problem statement","operationId":"recommendCyclrResources","parameters":[{"name":"problem","in":"query","required":false,"schema":{"type":"string"},"description":"Problem statement or research goal"},{"name":"query","in":"query","required":false,"schema":{"type":"string"},"description":"Alternative query\/problem parameter"}],"responses":{"200":{"description":"Recommendations","content":{"application\/json":{"schema":{"type":"object"}}}}}}},"\/openapi.json":{"get":{"summary":"Get OpenAPI description for the Cyclr Agent Content API","operationId":"getCyclrAgentOpenApi","responses":{"200":{"description":"OpenAPI document","content":{"application\/json":{"schema":{"type":"object"}}}}}}}}}